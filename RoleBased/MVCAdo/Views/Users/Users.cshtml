@model List<MVCAdo.Models.UserDto>

@using MVCAdo.Models


@{
    ViewData["Title"] = "Users";

    var permissions = ViewBag.Permissions as List<PermissionDto>;
    var userPermission = permissions?.FirstOrDefault(p => p.PageName.ToLower() == "users");
}

<div class="card shadow border-0 rounded-4">

    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h2 class="text-primary mb-0">
                Users Management
            </h2>

            @if (userPermission?.CanWrite == true)
            {
                <a asp-controller="Users" asp-action="Create" class="btn btn-success">
                    Create User
                </a>
            }

        </div>

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>@user.Id</td>

                        <td>@user.Name</td>

                        <td>@user.Email</td>

                        <td>

                            @if (userPermission?.CanWrite == true)
                            {
                                <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Users" asp-action="Delete"  asp-route-id="@user.Id" class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Read Only Access
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>